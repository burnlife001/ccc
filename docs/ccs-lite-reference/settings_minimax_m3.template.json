{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "<在此填入 token，或删除本行改用环境变量>",
    "ANTHROPIC_BASE_URL": "https://api.minimaxi.com/anthropic",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "MiniMax-M3",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "MiniMax-M3-highspeed",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "MiniMax-M3",
    "ANTHROPIC_MODEL": "MiniMax-M3",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000"
  },
  "modelPicker": {
    "options": [
      {
        "behavesAs": "claude-haiku-5-5",
        "label": "MiniMax M3 (Haiku)",
        "model": "MiniMax-M3"
      },
      {
        "behavesAs": "claude-sonnet-5-5",
        "label": "MiniMax M3 (Sonnet)",
        "model": "MiniMax-M3"
      },
      {
        "behavesAs": "claude-opus-5-5",
        "label": "MiniMax M3 (Opus · highspeed)",
        "model": "MiniMax-M3-highspeed"
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash", "Edit", "MultiEdit", "Write", "Read", "Glob", "Grep", "LS", "WebFetch", "WebSearch", "Rm"]
  },
  "skipDangerousModePermissionPrompt": true
}
